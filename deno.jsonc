{
  // "prod": true → "deno deploy" a secas apunta a producción. NO pasar --prod
  // en la línea de comando: el runner de GitHub Actions lo duplica y falla
  // ("Option --prod can only occur once") — bug real y persistente del CLI en
  // ese entorno (2026-08-29, reconfirmado 2026-09-03). Ver deploy-deno-hub.yml.
  "deploy": {
    "org": "pabloeckert",
    "app": "mejorastremio-hub",
    "prod": true
  }
}
